# =====================================================================
# Enterprise Support AI Agent: Environment Configuration Template
# Phase 11: Cloud Manifest & Infrastructure-as-Code (IaC)
# =====================================================================

# +-------------------------------------------------------------------+
# | 1. BACKEND RUNTIME SECRETS (CONFIDENTIAL)                         |
# | Injected at runtime into the backend container.                   |
# | NEVER expose these to the browser or commit real values to Git.    |
# +-------------------------------------------------------------------+

# LLM Inference API Key (Groq, OpenAI, or OmniRoute gateway)
LLM_API_KEY=your_llm_api_key_here
# Legacy fallback if LLM_API_KEY is not set
# GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL Database Password (used if DATABASE_URL is not supplied directly)
DB_PASSWORD=postgres

# Complete PostgreSQL Connection String (Overrides individual DB_* params if set)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# In Render: Automatically populated from the managed database via fromDatabase
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_support

# Dedicated LangGraph Checkpoint Database URL (Defaults to DATABASE_URL if unset)
# CHECKPOINT_DB_URL=postgresql://postgres:postgres@localhost:5432/enterprise_support


# +-------------------------------------------------------------------+
# | 2. BACKEND OPERATIONAL CONFIGURATION (NON-SECRET)                 |
# | Operational settings controlling ports, paths, and integrations.  |
# +-------------------------------------------------------------------+

# PostgreSQL Individual Connection Parameters (Used when DATABASE_URL is unset)
# For local native execution: DB_HOST=localhost
# For Docker Compose: DB_HOST=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enterprise_support
DB_USER=postgres
# SSL Mode: 'prefer' for local dev, 'require' for cloud managed databases
DB_SSLMODE=prefer

# LLM Provider Gateway & Model Choice
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# LangGraph PostgreSQL Checkpoint Persistence
# Set to "1" to use PostgreSQL checkpointing (PostgresSaver)
# Set to "0" to fall back to in-memory checkpointing (MemorySaver)
USE_POSTGRES_CHECKPOINT=1

# ChromaDB Vector Store Persistent Path
# Local native default: data/chroma
# Docker container default: /app/data/chroma
# Cloud persistent disk mount: /app/data/chroma
CHROMA_PATH=data/chroma

# FastAPI Gateway Allowed CORS Origins (Comma-separated)
# In production, include your cloud frontend HTTPS URL
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000

# Demo Data Seeding Control
# Set to "1" to seed enterprise demo records on database bootstrap
# Defaults to "0" in production cloud deployments to prevent accidental overwrites
SEED_DEMO_DATA=0


# +-------------------------------------------------------------------+
# | 3. FRONTEND PUBLIC CONFIGURATION (BROWSER-ACCESSIBLE)             |
# | WARNING: Variables prefixed with NEXT_PUBLIC_* are embedded into  |
# | client JavaScript bundles. NEVER place private credentials here!  |
# +-------------------------------------------------------------------+

# Base URL for frontend to communicate with FastAPI REST API
# Local dev default: http://localhost:8000
# Cloud deployment: https://enterprise-support-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000